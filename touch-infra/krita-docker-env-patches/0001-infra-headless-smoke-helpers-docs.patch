+### Running Krita headless (no X11/Wayland on host)
+
+To run Krita without a host display, use Xvfb inside the container:
+
+```bash
+./bin/krita-xvfb --version
+```
+
+To take a screenshot of Krita running under Xvfb (saved into `./persistent/`):
+
+```bash
+./bin/krita-xvfb-screenshot
+```
+
 ### PulseAudio socket fails to start after restarting the host system
 
 On KDE Neon the pulseaudio socket is sometimes created after the first usage of the
@@ -287,3 +301,13 @@ do the following:
 ```bash
 echo 'DOCKER_OPTS="-g /home/devel5/docker"' >> /etc/default/docker
 ```
+
+### Docker networking fails with "operation not supported"
+
+Some environments cannot create Docker's default bridge/veth networking (common in
+restricted containers/VMs). In that case use host networking for both build and run:
+
+```bash
+./bin/build_image --network=host krita-deps
+./bin/run_container --network=host krita-deps krita-auto-1
+```
diff --git a/bin/bg-build-krita b/bin/bg-build-krita
new file mode 100755
index 0000000..ed2a9ef
--- /dev/null
+++ b/bin/bg-build-krita
@@ -0,0 +1,99 @@
+#!/bin/bash
+
+set -euo pipefail
+
+usage=$(
+  cat <<'EOF'
+Usage: bg-build-krita [OPTION]... [-- BUILD_KRITA_ARGS...]
+
+Runs ./bin/build-krita in a detached tmux session and writes a log file.
+
+Options:
+  --session=NAME     tmux session name (default: krita-build-linux)
+  --log=PATH         log file path (default: persistent/build-linux-<ts>.log)
+  --attach           attach to the tmux session after starting
+  --follow           tail -f the log after starting
+  -h, --help         show this help text
+
+Examples:
+  ./bin/bg-build-krita -- --no-tests -j"$(nproc)"
+  ./bin/bg-build-krita --follow -- --no-tests -j2
+EOF
+)
+
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd "${DIR}/.." && pwd)"
+
+SESSION="krita-build-linux"
+LOG=""
+ATTACH=0
+FOLLOW=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --session=*)
+      SESSION="${1#*=}"
+      shift
+      ;;
+    --log=*)
+      LOG="${1#*=}"
+      shift
+      ;;
+    --attach)
+      ATTACH=1
+      shift
+      ;;
+    --follow)
+      FOLLOW=1
+      shift
+      ;;
+    -h|--help)
+      echo "$usage"
+      exit 0
+      ;;
+    --)
+      shift
+      break
+      ;;
+    *)
+      echo "Unknown option: $1" >&2
+      echo "$usage" >&2
+      exit 2
+      ;;
+  esac
+done
+
+cd "$ROOT"
+
+ts="$(date +%Y%m%d-%H%M%S)"
+if [[ -z "$LOG" ]]; then
+  LOG="persistent/build-linux-${ts}.log"
+fi
+
+mkdir -p "$(dirname "$LOG")"
+
+if [[ "$LOG" == persistent/* ]]; then
+  ln -sf "$(basename "$LOG")" persistent/build-linux.log
+fi
+
+if tmux has-session -t "$SESSION" 2>/dev/null; then
+  echo "tmux session already exists: $SESSION" >&2
+  echo "Attach with: tmux attach -t $SESSION" >&2
+  exit 3
+fi
+
+cmd=(./bin/build-krita "$@")
+cmd_str="$(printf '%q ' "${cmd[@]}")"
+
+tmux new-session -d -s "$SESSION" "cd $(printf '%q' "$ROOT") && ${cmd_str} 2>&1 | tee $(printf '%q' "$LOG")"
+
+echo "Started: tmux attach -t $SESSION"
+echo "Log: $LOG"
+
+if [[ $ATTACH -eq 1 ]]; then
+  exec tmux attach -t "$SESSION"
+fi
+
+if [[ $FOLLOW -eq 1 ]]; then
+  exec tail -f "$LOG"
+fi
