@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage="$(cat <<'USAGE_EOF'
+Usage: krita-xvfb-smoke-touch [OPTIONS]
+
+Run a batch of headless Linux touch smoke scenarios under Xvfb, saving one
+screenshot per scenario into ./persistent/.
+
+Options:
+  --container NAME     Container name (default: .container_name)
+  --wait SEC           Seconds to wait before screenshot per scenario (default: 10)
+  --scenario NAME      Scenario to run (repeatable). Default: built-in list.
+  -h, --help           Show help
+
+Scenarios are passed as: krita --touch-smoke=<scenario>
+USAGE_EOF
+)"
+
+CONTAINER_NAME=""
+WAIT_SECS="10"
+SCENARIOS=()
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --container)
+            CONTAINER_NAME="$2"
+            shift 2
+            ;;
+        --container=*)
+            CONTAINER_NAME="${1#*=}"
+            shift
+            ;;
+        --wait)
+            WAIT_SECS="$2"
+            shift 2
+            ;;
+        --wait=*)
+            WAIT_SECS="${1#*=}"
+            shift
+            ;;
+        --scenario)
+            SCENARIOS+=("$2")
+            shift 2
+            ;;
+        -h|--help)
+            echo "$usage"
+            exit 0
+            ;;
+        *)
+            echo "Unknown arg: $1" >&2
+            echo "$usage" >&2
+            exit 2
+            ;;
+    esac
+done
+
+DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+
+if [[ ${#SCENARIOS[@]} -eq 0 ]]; then
+    SCENARIOS+=("top-bar")
+    SCENARIOS+=("touch-sidebar")
+    SCENARIOS+=("selection-tool")
+    SCENARIOS+=("transform-tool")
+    SCENARIOS+=("layers-panel")
+    SCENARIOS+=("layer-options")
+    SCENARIOS+=("color-panel")
+    SCENARIOS+=("colordrop")
+    SCENARIOS+=("quickshape")
+    SCENARIOS+=("actions-sheet")
+    SCENARIOS+=("gesture-controls")
+    SCENARIOS+=("quickmenu")
+    SCENARIOS+=("quickmenu-setup")
+    SCENARIOS+=("copypaste")
+fi
+
+for SCENARIO in "${SCENARIOS[@]}"; do
+    slug="$(echo "$SCENARIO" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
+    out_file="smoke-linux-krita-${slug}.png"
+    log_file="smoke-linux-krita-${slug}-log.txt"
+    args=(--output="$out_file" --log="$log_file" --wait="$WAIT_SECS")
+    if [[ -n "$CONTAINER_NAME" ]]; then
+        args+=(--container="$CONTAINER_NAME")
+    fi
+
+    "$DIR/krita-xvfb-screenshot" "${args[@]}" -- --touch-smoke="$SCENARIO"
+    test -s "$DIR/../persistent/$out_file"
+    test -s "$DIR/../persistent/$log_file"
+done
+
+echo "OK: wrote ${#SCENARIOS[@]} screenshots under ./persistent/"
