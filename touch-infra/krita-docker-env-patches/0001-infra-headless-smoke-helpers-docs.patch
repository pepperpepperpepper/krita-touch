+\n
+	where:\n
+	    -h,      --help              show this help text\n
+	    -c NAME, --container=NAME    container name (defaults to .container_name)\n
+	    -o FILE, --output=FILE       output filename (default: krita-xvfb.png)\n
+	    -l FILE, --log=FILE          log filename (default: <output>-log.txt)\n
+	    -s RES,  --screen=RES        Xvfb screen (default: 1280x720x24)\n
+	    -w SEC,  --wait=SEC          seconds to wait before screenshot (default: 20)\n
+"
+
+SCREEN="1280x720x24"
+WAIT_SECS="20"
+OUT_FILE="krita-xvfb.png"
+LOG_FILE=""
+CONTAINER_NAME=
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+    -h | --help)
+        echo -e "$usage" >&2
+        exit 0
+        ;;
+    -c | --container)
+        CONTAINER_NAME="$2"
+        shift 2
+        ;;
+    -o | --output)
+        OUT_FILE="$2"
+        shift 2
+        ;;
+	    --output=*)
+	        OUT_FILE="${1#*=}"
+	        shift
+	        ;;
+	    -l | --log)
+	        LOG_FILE="$2"
+	        shift 2
+	        ;;
+	    --log=*)
+	        LOG_FILE="${1#*=}"
+	        shift
+	        ;;
+	    -s | --screen)
+	        SCREEN="$2"
+	        shift 2
+        ;;
+    --screen=*)
+        SCREEN="${1#*=}"
+        shift
+        ;;
+    -w | --wait)
+        WAIT_SECS="$2"
+        shift 2
+        ;;
+    --wait=*)
+        WAIT_SECS="${1#*=}"
+        shift
+        ;;
+    --container=*)
+        CONTAINER_NAME="${1#*=}"
+        shift
+        ;;
+    --)
+        shift
+        break
+        ;;
+    *)
+        break
+        ;;
+    esac
+done
+
+DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+source ${DIR}/find_default_container_file.inc
+
+if [[ -z ${CONTAINER_NAME} ]]; then
+    CONTAINER_NAME=$(findContainerName)
+fi
+
+if [[ -z ${CONTAINER_NAME} ]]; then
+    echo "ERROR: container name was not provided and .container_name was not found" >&2
+    exit 1
+fi
+
+tryStartContainer "${CONTAINER_NAME}"
+
+DOCKER_EXEC_OPTS="-i"
+if [[ -t 0 ]]; then
+    DOCKER_EXEC_OPTS="-it"
+fi
+
+if [[ -z ${LOG_FILE} ]]; then
+    base="${OUT_FILE}"
+    if [[ "${base}" == *.* ]]; then
+        base="${base%.*}"
+    fi
+    LOG_FILE="${base}-log.txt"
+fi
+
+${DOCKER_BINARY} exec ${DOCKER_EXEC_OPTS} "${CONTAINER_NAME}" bash -lc \
+    'source /home/appimage/devenv.inc && \
+     xvfb-run -a -s "-screen 0 '"${SCREEN}"'" bash -lc '\'' \
+         source /home/appimage/devenv.inc; \
+         export LIBGL_ALWAYS_SOFTWARE=1; \
+         OUT_PATH="/home/appimage/persistent/'"${OUT_FILE}"'"; \
+         LOG_PATH="/home/appimage/persistent/'"${LOG_FILE}"'"; \
+         rm -f "$OUT_PATH"; \
+         rm -f "$LOG_PATH"; \
