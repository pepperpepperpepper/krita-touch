diff --git a/bin/build-krita-android b/bin/build-krita-android
new file mode 100755
index 0000000..e87de13
--- /dev/null
+++ b/bin/build-krita-android
@@ -0,0 +1,239 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage="$(cat <<'USAGE_EOF'
+Usage: build-krita-android [OPTIONS]
+
+Build a Krita Android APK inside the Android Docker container, mirroring Krita CI.
+
+Options:
+  --container NAME       Container name (default: .container_name)
+  --abi ABI              Android ABI (default: arm64-v8a)
+  --package-type TYPE    debug | release | nightly (default: debug)
+  --workdir PATH         KDECI_WORKDIR_PATH inside container (default: /home/appimage/persistent/wd)
+  --jobs N               Parallel build jobs (default: nproc)
+  --only-build           Run CI build step only (no APK packaging)
+  --only-package         Run APK packaging only (assumes workdir has _build/)
+  -h, --help             Show help
+
+Notes:
+- APK output: $workdir/krita/_packaging/*.apk (host: ./persistent/wd/krita/_packaging/*.apk)
+- This script does NOT sign APKs.
+USAGE_EOF
+)"
+
+CONTAINER_NAME=""
+ABI="arm64-v8a"
+PACKAGE_TYPE="debug"
+WORKDIR="/home/appimage/persistent/wd"
+JOBS="$(nproc)"
+ONLY_BUILD=0
+ONLY_PACKAGE=0
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --container)
+            CONTAINER_NAME="$2"
+            shift 2
+            ;;
+        --container=*)
+            CONTAINER_NAME="${1#*=}"
+            shift
+            ;;
+        --abi)
+            ABI="$2"
+            shift 2
+            ;;
+        --abi=*)
+            ABI="${1#*=}"
+            shift
+            ;;
+        --package-type)
+            PACKAGE_TYPE="$2"
+            shift 2
+            ;;
+        --package-type=*)
+            PACKAGE_TYPE="${1#*=}"
+            shift
+            ;;
+        --workdir)
+            WORKDIR="$2"
+            shift 2
+            ;;
+        --workdir=*)
+            WORKDIR="${1#*=}"
+            shift
+            ;;
+        --jobs)
+            JOBS="$2"
+            shift 2
+            ;;
+        --jobs=*)
+            JOBS="${1#*=}"
+            shift
+            ;;
+        --only-build)
+            ONLY_BUILD=1
+            shift
+            ;;
+        --only-package)
+            ONLY_PACKAGE=1
+            shift
+            ;;
+        -h|--help)
+            echo "$usage"
+            exit 0
+            ;;
+        *)
+            echo "Unknown arg: $1" >&2
+            echo "$usage" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ "$ONLY_BUILD" == "1" && "$ONLY_PACKAGE" == "1" ]]; then
+    echo "ERROR: --only-build and --only-package are mutually exclusive" >&2
+    exit 2
+fi
+
+case "$ABI" in
+    arm64-v8a|armeabi-v7a|x86_64) ;;
+    *)
+        echo "ERROR: unsupported ABI: $ABI (expected arm64-v8a|armeabi-v7a|x86_64)" >&2
+        exit 2
+        ;;
+esac
+
+case "$PACKAGE_TYPE" in
+    debug|release|nightly) ;;
+    *)
+        echo "ERROR: unsupported --package-type: $PACKAGE_TYPE (expected debug|release|nightly)" >&2
+        exit 2
+        ;;
+esac
+
+DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+ROOT="$(cd "${DIR}/.." && pwd)"
+source "$DIR/find_default_container_file.inc"
+
+if [[ -z "$CONTAINER_NAME" ]]; then
+    CONTAINER_NAME="$(findContainerName)"
+fi
+if [[ -z "$CONTAINER_NAME" ]]; then
+    echo "ERROR: no container specified (use --container NAME or run ./bin/run_container)" >&2
+    exit 1
+fi
+
+LOCK_DIR="$ROOT/persistent/.lock-build-krita-android-${ABI}"
+mkdir -p "$ROOT/persistent"
+if ! mkdir "$LOCK_DIR" 2>/dev/null; then
+    echo "ERROR: Android build already running (lock exists): $LOCK_DIR" >&2
+    echo "If this is stale, remove it and retry: rmdir $LOCK_DIR" >&2
+    exit 3
+fi
+trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
+
+tryStartContainer "$CONTAINER_NAME"
+
+DOCKER_EXEC_OPTS="-i"
+if [[ -t 0 ]]; then
+    DOCKER_EXEC_OPTS="-it"
+fi
+
+KDECI_PACKAGE_PROJECT="teams/ci-artifacts/krita-android-$ABI"
+PERSISTENT_ROOT="/home/appimage/persistent"
+KDECI_CC_CACHE="$PERSISTENT_ROOT/deps/ccache/krita-android/$ABI"
+KDECI_CACHE_PATH="$PERSISTENT_ROOT/deps/cache"
+KDECI_REPO_METADATA_PATH="$PERSISTENT_ROOT/deps/krita-deps-management/repo-metadata"
+CMAKE_TOOLCHAIN_FILE="$PERSISTENT_ROOT/deps/krita-deps-management/tools/android-toolchain-krita.cmake"
+VENV_PATH="$WORKDIR/venv"
+
+read -r -d '' INNER_CMD <<'EOF' || true
+set -euo pipefail
+
+if [[ -f /var/lib/ci-files/setup-environment.sh ]]; then
+  . /var/lib/ci-files/setup-environment.sh
+else
+  echo "ERROR: /var/lib/ci-files/setup-environment.sh not found (are you using the Android CI image?)" >&2
+  exit 1
+fi
+
+export KDECI_ANDROID_ABI="$ABI"
+export KDECI_WORKDIR_PATH="$WORKDIR"
+export KDECI_GITLAB_SERVER="https://invent.kde.org/"
+export KDECI_PACKAGE_PROJECT="$KDECI_PACKAGE_PROJECT"
+export KDECI_CACHE_PATH="$KDECI_CACHE_PATH"
+export KDECI_CC_CACHE="$KDECI_CC_CACHE"
+export KDECI_REPO_METADATA_PATH="$KDECI_REPO_METADATA_PATH"
+export KDECI_COMPRESS_PACKAGES_ON_DOWNLOAD="False"
+export KDECI_SKIP_ECM_ANDROID_TOOLCHAIN="True"
+export CMAKE_TOOLCHAIN_FILE="$CMAKE_TOOLCHAIN_FILE"
+export KDECI_BUILD_TYPE="Release"
+export KDECI_EXTRA_CMAKE_ARGS="-DHIDE_SAFE_ASSERTS=OFF -DBUILD_TESTING=ON"
+export KRITACI_ANDROID_PACKAGE_TYPE="$PACKAGE_TYPE"
+export KRITACI_PARALLEL_JOBS="$JOBS"
+
+mkdir -p "$KDECI_CACHE_PATH" "$KDECI_CC_CACHE" "$WORKDIR"
+
+if [[ ! -d "$VENV_PATH" ]]; then
+  python3 -m venv "$VENV_PATH" --upgrade-deps
+fi
+
+. "$VENV_PATH/bin/activate"
+python3 -m pip install -r /home/appimage/persistent/deps/krita-deps-management/requirements.txt
+unset VIRTUAL_ENV
+
+git config --global --add safe.directory /home/appimage/persistent/krita >/dev/null 2>&1 || true
+cd /home/appimage/persistent/krita
+
+KDECI_CONFIG_BAK=""
+restore_kde_ci_config() {
+  if [[ -n "$KDECI_CONFIG_BAK" && -f "$KDECI_CONFIG_BAK" ]]; then
+    mv -f "$KDECI_CONFIG_BAK" .kde-ci.yml
+  fi
+}
+trap restore_kde_ci_config EXIT
+
+if [[ -f .kde-ci.yml ]]; then
+  KDECI_CONFIG_BAK="$(mktemp)"
+  cp -f .kde-ci.yml "$KDECI_CONFIG_BAK"
+fi
+
+python3 -u /home/appimage/persistent/deps/krita-deps-management/tools/generate-deps-file.py \
+  -s /home/appimage/persistent/deps/krita-deps-management/latest/krita-deps.yml \
+  -o .kde-ci.yml
+
+BRANCH_NAME="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo local)"
+PLATFORM_NAME="Android/$ABI/Qt5/Shared"
+
+if [[ "$ONLY_PACKAGE" != "1" ]]; then
+  python3 -u /home/appimage/persistent/deps/krita-deps-management/ci-utilities/run-ci-build.py \
+    --project krita \
+    --branch "$BRANCH_NAME" \
+    --platform "$PLATFORM_NAME" \
+    --only-build \
+    --skip-publishing
+fi
+
+if [[ "$ONLY_BUILD" != "1" ]]; then
+  python3 -u build-tools/ci-scripts/build-android-package.py --package-type "$KRITACI_ANDROID_PACKAGE_TYPE"
+fi
+
+echo "OK: APKs under: $WORKDIR/krita/_packaging/"
+EOF
+
+"$DOCKER_BINARY" exec $DOCKER_EXEC_OPTS \
+  -e ABI="$ABI" \
+  -e WORKDIR="$WORKDIR" \
+  -e JOBS="$JOBS" \
+  -e ONLY_BUILD="$ONLY_BUILD" \
+  -e ONLY_PACKAGE="$ONLY_PACKAGE" \
+  -e PACKAGE_TYPE="$PACKAGE_TYPE" \
+  -e KDECI_PACKAGE_PROJECT="$KDECI_PACKAGE_PROJECT" \
+  -e KDECI_CC_CACHE="$KDECI_CC_CACHE" \
+  -e KDECI_CACHE_PATH="$KDECI_CACHE_PATH" \
+  -e KDECI_REPO_METADATA_PATH="$KDECI_REPO_METADATA_PATH" \
+  -e CMAKE_TOOLCHAIN_FILE="$CMAKE_TOOLCHAIN_FILE" \
+  -e VENV_PATH="$VENV_PATH" \
+  "$CONTAINER_NAME" bash -lc "$INNER_CMD"
