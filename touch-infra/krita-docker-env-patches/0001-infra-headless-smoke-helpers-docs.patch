diff --git a/bin/gmsaas-smoke-android b/bin/gmsaas-smoke-android
new file mode 100755
index 0000000..e52dc8e
--- /dev/null
+++ b/bin/gmsaas-smoke-android
@@ -0,0 +1,561 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage="$(cat <<'USAGE_EOF'
+Usage: gmsaas-smoke-android [OPTIONS]
+
+Run a headless Android smoke test on Genymotion Cloud:
+  - provision instance from a Recipe
+  - install an APK
+  - launch the app
+  - take a screenshot + capture logcat
+  - cleanup (stop instance + stop adb tunnel)
+
+Options:
+  --recipe UUID        Genymotion recipe UUID (default: KRITA_GMSAAS_RECIPE_UUID or krita_tablet_api35 UUID)
+  --apk FILE           APK to install (default: newest ./persistent/wd/krita/_packaging/*.apk)
+  --scenario NAME      Launch with intent extra KRITA_TOUCH_SMOKE=NAME (repeatable)
+  --activity NAME      Activity class name (default: org.krita.android.MainActivity)
+  --out-dir DIR        Output directory (default: ./persistent)
+  --wait SEC           If --scenario is set: max seconds to wait for KRITA_TOUCH_SMOKE_DONE (default: 80).
+                      If no scenario is set: seconds to sleep after launch before screenshot.
+  --no-marker-wait     Do not wait for KRITA_TOUCH_SMOKE_DONE; always sleep --wait seconds.
+  --max-run MIN        Genymotion max run duration in minutes (default: 60)
+  -h, --help           Show help
+
+Environment:
+  KRITA_GMSAAS_RECIPE_UUID   Recipe UUID override
+  GMSAAS_BIN                 Path to gmsaas binary (optional)
+USAGE_EOF
+)"
+
+RECIPE_UUID="${KRITA_GMSAAS_RECIPE_UUID:-6112dd0d-91c9-420d-a2ff-f71a691b9dd8}" # krita_tablet_api35
+APK_PATH=""
+SCENARIOS=()
+ACTIVITY="org.krita.android.MainActivity"
+OUT_DIR="./persistent"
+WAIT_SECS="80"
+MARKER_WAIT_ENABLED="1"
+MAX_RUN_MINS="60"
+START_RETRIES="3"
+
+GMSAAS_ADB_START_TIMEOUT_SECS="90"
+GMSAAS_INSTANCE_START_TIMEOUT_SECS="180"
+GMSAAS_ADBCONNECT_TIMEOUT_SECS="60"
+GMSAAS_INSTANCE_STOP_TIMEOUT_SECS="90"
+GMSAAS_ADB_STOP_TIMEOUT_SECS="30"
+
+ADB_RECONNECT_RETRIES="30"
+ADB_RECONNECT_SLEEP_SECS="4"
+
+ADB_WAIT_FOR_DEVICE_TIMEOUT_SECS="180"
+ADB_INSTALL_TIMEOUT_SECS="420"
+ADB_AM_START_TIMEOUT_SECS="120"
+ADB_SCREENSHOT_TIMEOUT_SECS="30"
+ADB_LOGCAT_DUMP_TIMEOUT_SECS="30"
+ADB_UIAUTOMATOR_TIMEOUT_SECS="20"
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --recipe)
+            RECIPE_UUID="$2"
+            shift 2
+            ;;
+        --apk)
+            APK_PATH="$2"
+            shift 2
+            ;;
+        --scenario)
+            SCENARIOS+=("$2")
+            shift 2
+            ;;
+        --activity)
+            ACTIVITY="$2"
+            shift 2
+            ;;
+        --out-dir)
+            OUT_DIR="$2"
+            shift 2
+            ;;
+        --wait)
+            WAIT_SECS="$2"
+            shift 2
+            ;;
+        --no-marker-wait)
+            MARKER_WAIT_ENABLED="0"
+            shift
+            ;;
+        --max-run)
+            MAX_RUN_MINS="$2"
+            shift 2
+            ;;
+        -h|--help)
+            echo "$usage"
+            exit 0
+            ;;
+        *)
+            echo "Unknown arg: $1" >&2
+            echo "$usage" >&2
+            exit 2
+            ;;
+    esac
+done
+
+GMSAAS="${GMSAAS_BIN:-}"
+if [[ -z "$GMSAAS" ]]; then
+    if command -v gmsaas >/dev/null 2>&1; then
+        GMSAAS="gmsaas"
+    elif [[ -x "$HOME/.local/pipx/venvs/gmsaas/bin/gmsaas" ]]; then
+        GMSAAS="$HOME/.local/pipx/venvs/gmsaas/bin/gmsaas"
+    elif [[ -x "$HOME/.venvs/gmsaas/bin/gmsaas" ]]; then
+        GMSAAS="$HOME/.venvs/gmsaas/bin/gmsaas"
+    else
+        echo "ERROR: gmsaas not found (set GMSAAS_BIN or install gmsaas)" >&2
+        exit 1
+    fi
+fi
+
+if ! command -v adb >/dev/null 2>&1; then
+    echo "ERROR: adb not found in PATH" >&2
+    exit 1
+fi
+
+if [[ -z "$APK_PATH" ]]; then
+    shopt -s nullglob
+    candidates=(./persistent/wd/krita/_packaging/*.apk)
+    shopt -u nullglob
+    if [[ ${#candidates[@]} -eq 0 ]]; then
+        echo "ERROR: no APK found under ./persistent/wd/krita/_packaging/*.apk (use --apk FILE)" >&2
+        exit 1
+    fi
+    APK_PATH="$(ls -t "${candidates[@]}" | head -1)"
+fi
+
+if [[ ! -f "$APK_PATH" ]]; then
+    echo "ERROR: APK not found: $APK_PATH" >&2
+    exit 1
+fi
+
+mkdir -p "$OUT_DIR"
+
+IID=""
+SER=""
+MARKER_WAIT_PID=""
+
+now_utc() {
+    date -u +%Y-%m-%dT%H:%M:%SZ
+}
+
+log() {
+    echo "[$(now_utc)] $*"
+}
+
+warn() {
+    echo "[$(now_utc)] WARN: $*" >&2
+}
+
+err() {
+    echo "[$(now_utc)] ERROR: $*" >&2
+}
+
+cleanup() {
+    set +e
+    if [[ -n "${MARKER_WAIT_PID}" ]]; then
+        kill "${MARKER_WAIT_PID}" >/dev/null 2>&1 || true
+        MARKER_WAIT_PID=""
+    fi
+    if [[ -n "$IID" ]]; then
+        run_with_timeout "$GMSAAS_INSTANCE_STOP_TIMEOUT_SECS" "$GMSAAS" instances stop "$IID" >/dev/null 2>&1 || true
+    fi
+    run_with_timeout "$GMSAAS_ADB_STOP_TIMEOUT_SECS" "$GMSAAS" adb stop >/dev/null 2>&1 || true
+}
+trap cleanup EXIT INT TERM HUP
+
+run_with_timeout() {
+    local secs="$1"
+    shift
+    if command -v timeout >/dev/null 2>&1; then
+        timeout "$secs" "$@"
+    else
+        "$@"
+    fi
+}
+
+gmsaas_adb_start() {
+    # Don't let a stuck tunnel/provisioning hang the whole CI job forever.
+    run_with_timeout "$GMSAAS_ADB_START_TIMEOUT_SECS" "$GMSAAS" adb start >/dev/null
+}
+
+start_instance_with_retry() {
+    local base_name="$1"
+
+    local attempt name out code parsed_uuid
+    for attempt in $(seq 1 "$START_RETRIES"); do
+        name="$base_name"
+        if [[ "$attempt" -gt 1 ]]; then
+            name="${base_name}-r${attempt}"
+        fi
+
+        set +e
+        out="$(run_with_timeout "$GMSAAS_INSTANCE_START_TIMEOUT_SECS" "$GMSAAS" instances start "$RECIPE_UUID" "$name" --max-run-duration "$MAX_RUN_MINS" --no-wait 2>&1)"
+        code=$?
+        set -e
+
+        if [[ "$code" -eq 0 ]]; then
+            IID="$(echo "$out" | tail -n1 | tr -d '\r')"
+            if [[ -z "$IID" ]]; then
+                echo "ERROR: Genymotion instance start returned empty UUID (output: $out)" >&2
+                return 10
+            fi
+            return 0
+        fi
+
+        if [[ "$code" -eq 124 ]]; then
+            err "Timed out starting Genymotion instance (timeout=${GMSAAS_INSTANCE_START_TIMEOUT_SECS}s)."
+        fi
+
+        # gmsaas can fail but still report the instance UUID in the error message:
+        # "Error: instance 'UUID' failed to start..."
+        parsed_uuid="$(echo "$out" | sed -nE "s/.*instance '([0-9a-fA-F-]+)'.*/\\1/p" | head -n1 | tr -d '\r')"
+        if [[ -n "$parsed_uuid" ]]; then
+            IID="$parsed_uuid"
+        fi
+
+        echo "$out" >&2
+
+        # Best-effort cleanup so we don't leak an ERROR instance (important for CI).
+        if [[ -n "$IID" ]]; then
+            run_with_timeout "$GMSAAS_INSTANCE_STOP_TIMEOUT_SECS" "$GMSAAS" instances stop "$IID" >/dev/null 2>&1 || true
+            IID=""
+        fi
+
+        if [[ "$attempt" -lt "$START_RETRIES" ]]; then
+            echo "WARN: Genymotion instance failed to start; retrying (${attempt}/${START_RETRIES})..." >&2
+            sleep 4
+        fi
+    done
+
+    echo "ERROR: failed to start Genymotion instance after ${START_RETRIES} attempts" >&2
+    return 10
+}
+
+adbconnect_with_retry() {
+    local attempt out code serial
+    for attempt in $(seq 1 "$ADB_RECONNECT_RETRIES"); do
+        set +e
+        out="$(run_with_timeout "$GMSAAS_ADBCONNECT_TIMEOUT_SECS" "$GMSAAS" instances adbconnect "$IID" 2>&1)"
+        code=$?
+        set -e
+        if [[ "$code" -eq 0 ]]; then
+            serial="$(echo "$out" | tail -n1 | tr -d '\r')"
+            if [[ -n "$serial" ]]; then
+                SER="$serial"
+                return 0
+            fi
+        fi
+        if [[ "$attempt" -eq 1 ]]; then
+            warn "Waiting for Genymotion instance to accept adbconnect..."
+        fi
+        sleep "$ADB_RECONNECT_SLEEP_SECS"
+    done
+    err "Failed to adbconnect to instance $IID after ${ADB_RECONNECT_RETRIES} attempts"
+    return 1
+}
+
+is_adb_missing_device_error() {
+    local path="$1"
+    grep -qiE "(device( '.*')? not found|no devices/emulators found|device offline)" "$path" 2>/dev/null
+}
+
+ensure_adb_serial() {
+    # Reconnect if the adb tunnel dropped and the serial vanished.
+    local tmp_err
+    tmp_err="$(mktemp)"
+    if adb -s "$SER" shell true 2>"$tmp_err" >/dev/null; then
+        rm -f "$tmp_err"
+        return 0
+    fi
+    if is_adb_missing_device_error "$tmp_err"; then
+        warn "adb lost device '$SER'; reconnecting via gmsaas..."
+        rm -f "$tmp_err"
+        gmsaas_adb_start >/dev/null 2>&1 || true
+        adbconnect_with_retry
+        run_with_timeout "$ADB_WAIT_FOR_DEVICE_TIMEOUT_SECS" adb -s "$SER" wait-for-device || true
+        return 0
+    fi
+    cat "$tmp_err" >&2 || true
+    rm -f "$tmp_err"
+    return 1
+}
+
+adb_screencap_to_file() {
+    local out_path="$1"
+    local attempt tmp_err rc
+    for attempt in 1 2; do
+        tmp_err="$(mktemp)"
+        if run_with_timeout "$ADB_SCREENSHOT_TIMEOUT_SECS" adb -s "$SER" exec-out screencap -p >"$out_path" 2>"$tmp_err"; then
+            rm -f "$tmp_err"
+            return 0
+        fi
+        rc=$?
+        if is_adb_missing_device_error "$tmp_err"; then
+            warn "screencap failed due to missing adb device; retrying (${attempt}/2)..."
+            rm -f "$tmp_err"
+            ensure_adb_serial || true
+            continue
+        fi
+        cat "$tmp_err" >&2 || true
+        rm -f "$tmp_err"
+        return "$rc"
+    done
+    return "$rc"
+}
+
+adb_logcat_dump_to_file() {
+    local out_path="$1"
+    local attempt tmp_err rc
+    for attempt in 1 2; do
+        tmp_err="$(mktemp)"
+        if run_with_timeout "$ADB_LOGCAT_DUMP_TIMEOUT_SECS" adb -s "$SER" logcat -d >"$out_path" 2>"$tmp_err"; then
+            rm -f "$tmp_err"
+            return 0
+        fi
+        rc=$?
+        if is_adb_missing_device_error "$tmp_err"; then
+            warn "logcat dump failed due to missing adb device; retrying (${attempt}/2)..."
+            rm -f "$tmp_err"
+            ensure_adb_serial || true
+            continue
+        fi
+        cat "$tmp_err" >&2 || true
+        rm -f "$tmp_err"
+        return "$rc"
+    done
+    return "$rc"
+}
+
+wake_and_unlock() {
+    # Genymotion Cloud instances often boot into the lock screen; if we don't
+    # unlock, screenshots will show the launcher/lockscreen instead of Krita.
+    #
+    # These commands are best-effort; some may fail depending on Android build.
+    adb -s "$SER" shell input keyevent 224 >/dev/null 2>&1 || true # KEYCODE_WAKEUP
+    adb -s "$SER" shell wm dismiss-keyguard >/dev/null 2>&1 || true
+
+    local size
+    size="$(adb -s "$SER" shell wm size 2>/dev/null | tr -d '\r' || true)"
+    if [[ "$size" =~ ([0-9]+)x([0-9]+) ]]; then
+        local w h x y1 y2
+        w="${BASH_REMATCH[1]}"
+        h="${BASH_REMATCH[2]}"
+        x=$((w / 2))
+        y1=$((h * 8 / 10))
+        y2=$((h * 2 / 10))
+        adb -s "$SER" shell input swipe "$x" "$y1" "$x" "$y2" 300 >/dev/null 2>&1 || true
+    else
+        adb -s "$SER" shell input swipe 500 1800 500 200 300 >/dev/null 2>&1 || true
+    fi
+
+    adb -s "$SER" shell input keyevent 82 >/dev/null 2>&1 || true # KEYCODE_MENU
+}
+
+dismiss_viewing_fullscreen_tip() {
+    # Android sometimes shows a first-run system tip overlay:
+    # "Viewing full screen" + "Got it". If we don't dismiss it, screenshots
+    # capture the overlay instead of Krita UI.
+    local xml line bounds
+    if ! run_with_timeout "$ADB_UIAUTOMATOR_TIMEOUT_SECS" adb -s "$SER" shell uiautomator dump /sdcard/uidump.xml >/dev/null 2>&1; then
+        return 0
+    fi
+
+    xml="$(run_with_timeout "$ADB_UIAUTOMATOR_TIMEOUT_SECS" adb -s "$SER" exec-out cat /sdcard/uidump.xml 2>/dev/null | tr -d '\r' || true)"
+    if [[ -z "$xml" ]]; then
+        return 0
+    fi
+
+    if echo "$xml" | grep -qi 'text="Viewing full screen"' && echo "$xml" | grep -qi 'text="Got it"'; then
+        line="$(echo "$xml" | tr -d '\n' | sed -n 's/.*\\(<node[^>]*text="Got it"[^>]*>\\).*/\\1/p')"
+        if [[ -z "$line" ]]; then
+            line="$(echo "$xml" | grep -im1 'text="Got it"' || true)"
+        fi
+        bounds="$(echo "$line" | sed -n 's/.*bounds=\"\\([^\"]*\\)\".*/\\1/p' || true)"
+        if [[ "$bounds" =~ \\[([0-9]+),([0-9]+)\\]\\[([0-9]+),([0-9]+)\\] ]]; then
+            local x y
+            x=$(( (BASH_REMATCH[1] + BASH_REMATCH[3]) / 2 ))
+            y=$(( (BASH_REMATCH[2] + BASH_REMATCH[4]) / 2 ))
+            adb -s "$SER" shell input tap "$x" "$y" >/dev/null 2>&1 || true
+            return 0
+        fi
+    fi
+}
+
+wait_for_touch_smoke_done() {
+    local scenario="$1"
+    local timeout="$2"
+    local marker_file="$3"
+
+    if ! command -v timeout >/dev/null 2>&1; then
+        return 1
+    fi
+
+    local scenario_norm marker
+    scenario_norm="$(echo "$scenario" | tr '[:upper:]' '[:lower:]')"
+    marker="KRITA_TOUCH_SMOKE_DONE scenario=$scenario_norm status="
+
+    # NOTE: don't use pipefail here. When grep finds the marker and exits,
+    # adb logcat is expected to terminate via SIGPIPE; with pipefail enabled
+    # that would incorrectly look like a failure.
+    ( set +o pipefail; timeout "$timeout" adb -s "$SER" logcat -v brief 2>/dev/null | grep -m1 -F "$marker" >"$marker_file" ) &
+    MARKER_WAIT_PID="$!"
+    return 0
+}
+
+log "Using recipe: $RECIPE_UUID"
+log "Using APK: $APK_PATH"
+log "Activity: $ACTIVITY"
+log "Output dir: $OUT_DIR"
+
+gmsaas_adb_start
+
+INSTANCE_NAME="krita-smoke-$(date -u +%Y%m%d-%H%M%S)"
+start_instance_with_retry "$INSTANCE_NAME"
+adbconnect_with_retry
+
+log "Instance UUID: $IID"
+log "ADB serial: $SER"
+
+run_with_timeout "$ADB_WAIT_FOR_DEVICE_TIMEOUT_SECS" adb -s "$SER" wait-for-device || true
+for i in {1..60}; do
+    v="$(adb -s "$SER" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
+    if [[ "$v" == "1" ]]; then
+        break
+    fi
+    sleep 2
+done
+
+adb -s "$SER" shell svc power stayon true >/dev/null 2>&1 || true
+wake_and_unlock
+
+adb -s "$SER" logcat -c || true
+
+run_with_timeout "$ADB_INSTALL_TIMEOUT_SECS" adb -s "$SER" install -r "$APK_PATH"
+
+PKG=""
+for i in {1..10}; do
+    PKG="$(adb -s "$SER" shell pm list packages org.krita | head -1 | cut -d: -f2 | tr -d '\r')"
+    if [[ -n "$PKG" ]]; then
+        break
+    fi
+    sleep 1
+done
+
+if [[ -z "$PKG" ]]; then
+    echo "ERROR: could not detect installed package (expected org.krita*) after install" >&2
+    adb -s "$SER" shell pm list packages | grep -i krita || true
+    exit 1
+fi
+
+if [[ ${#SCENARIOS[@]} -eq 0 ]]; then
+    SCENARIOS+=("")
+fi
+
+total="${#SCENARIOS[@]}"
+idx="0"
+for SCENARIO in "${SCENARIOS[@]}"; do
+    idx=$((idx + 1))
+    OUT_SUFFIX="krita"
+    if [[ -n "$SCENARIO" ]]; then
+        OUT_SUFFIX="krita-$(echo "$SCENARIO" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
+        log "[${idx}/${total}] Launching package: $PKG (scenario: $SCENARIO)"
+    else
+        log "[${idx}/${total}] Launching package: $PKG"
+    fi
+
+    ensure_adb_serial || true
+    wake_and_unlock
+
+    adb -s "$SER" shell am force-stop "$PKG" >/dev/null 2>&1 || true
+    adb -s "$SER" logcat -c || true
+
+    MARKER_WAIT_PID=""
+    MARKER_FILE="$(mktemp)"
+    USE_MARKER_WAIT="0"
+    if [[ -n "$SCENARIO" ]]; then
+        if [[ "$MARKER_WAIT_ENABLED" == "1" ]]; then
+            if ! wait_for_touch_smoke_done "$SCENARIO" "$WAIT_SECS" "$MARKER_FILE"; then
+                echo "WARN: timeout(1) not found; falling back to sleep ${WAIT_SECS}s" >&2
+            else
+                USE_MARKER_WAIT="1"
+            fi
+        fi
+    fi
+
+    if [[ -n "$SCENARIO" ]]; then
+        run_with_timeout "$ADB_AM_START_TIMEOUT_SECS" adb -s "$SER" shell am start -W -n "$PKG/$ACTIVITY" --es KRITA_TOUCH_SMOKE "$SCENARIO"
+    else
+        run_with_timeout "$ADB_AM_START_TIMEOUT_SECS" adb -s "$SER" shell am start -W -n "$PKG/$ACTIVITY"
+    fi
+
+    if [[ -n "$SCENARIO" ]]; then
+        if [[ "$USE_MARKER_WAIT" != "1" ]]; then
+            sleep "$WAIT_SECS"
+        elif ! wait "$MARKER_WAIT_PID"; then
+            echo "ERROR: timed out waiting for KRITA_TOUCH_SMOKE_DONE for scenario: $SCENARIO (timeout=${WAIT_SECS}s)" >&2
+            adb -s "$SER" logcat -d > "$OUT_DIR/smoke-android-$OUT_SUFFIX-logcat.txt" || true
+            exit 1
+        fi
+        MARKER_WAIT_PID=""
+
+        if [[ "$USE_MARKER_WAIT" == "1" ]]; then
+            marker_line="$(tr -d '\r' <"$MARKER_FILE" || true)"
+            if [[ "$marker_line" != *"status=OK"* ]]; then
+                echo "ERROR: touch smoke scenario did not report OK: $marker_line" >&2
+                adb -s "$SER" logcat -d > "$OUT_DIR/smoke-android-$OUT_SUFFIX-logcat.txt" || true
+                exit 1
+            fi
+        fi
+
+        # Small settle time for rendering.
+        sleep 1
+    else
+        sleep "$WAIT_SECS"
+    fi
+
+    rm -f "$MARKER_FILE" >/dev/null 2>&1 || true
+    dismiss_viewing_fullscreen_tip || true
+
+    OUT_PNG="$OUT_DIR/smoke-android-$OUT_SUFFIX.png"
+    OUT_LOG="$OUT_DIR/smoke-android-$OUT_SUFFIX-logcat.txt"
+
+    if ! adb_screencap_to_file "$OUT_PNG"; then
+        err "Failed to capture screenshot (timeout=${ADB_SCREENSHOT_TIMEOUT_SECS}s): $OUT_PNG"
+        rm -f "$OUT_PNG" >/dev/null 2>&1 || true
+        exit 1
+    fi
+
+    if ! adb_logcat_dump_to_file "$OUT_LOG"; then
+        err "Failed to capture logcat (timeout=${ADB_LOGCAT_DUMP_TIMEOUT_SECS}s): $OUT_LOG"
+        rm -f "$OUT_LOG" >/dev/null 2>&1 || true
+        exit 1
+    fi
+
+    if [[ ! -s "$OUT_PNG" ]]; then
+        echo "ERROR: screenshot is empty: $OUT_PNG" >&2
+        exit 1
+    fi
+
+    if grep -q "FATAL EXCEPTION" "$OUT_LOG" && grep -q "Process: $PKG" "$OUT_LOG"; then
+        echo "ERROR: detected app crash (FATAL EXCEPTION) for $PKG" >&2
+        grep -nE "FATAL EXCEPTION|Process: $PKG" "$OUT_LOG" | tail -50 >&2 || true
+        exit 1
+    fi
+
+    if grep -q "ANR in $PKG" "$OUT_LOG"; then
+        echo "ERROR: detected ANR for $PKG" >&2
+        grep -nE "ANR in $PKG" "$OUT_LOG" | tail -50 >&2 || true
+        exit 1
+    fi
+
+    log "Saved screenshot: $OUT_PNG"
+    log "Saved logcat: $OUT_LOG"
+done
diff --git a/bin/krita-xvfb b/bin/krita-xvfb
new file mode 100755
index 0000000..70374f7
--- /dev/null
+++ b/bin/krita-xvfb
@@ -0,0 +1,61 @@
+#!/bin/bash
+
+usage=\
+"Usage: $(basename "$0") [OPTION]... [--] [KRITA_ARGS...]\n
+Run Krita under Xvfb inside the current container\n
+\n
+where:\n
+    -h,      --help              show this help text\n
+    -c NAME, --container=NAME    container name (defaults to .container_name)\n
+    -s RES,  --screen=RES        Xvfb screen, default: 1280x720x24\n
+"
+
+SCREEN="1280x720x24"
